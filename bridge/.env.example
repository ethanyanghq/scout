# Settings for the iMessage bridge. Copy this file to bridge/.env (Bun loads
# it automatically when you run `bun start` here):
#
#   cp bridge/.env.example bridge/.env
#
# bridge/.env is git-ignored. Never commit real secrets. Leave a line
# commented out rather than empty: an empty value counts as set.

# "local" runs on this Mac's Messages account (needs Full Disk Access for the
# terminal, no Photon plan). "cloud" uses a Photon cloud line. "linq" uses a
# Linq line in group chats, with no Apple ID on this Mac.
IMESSAGE_MODE=local

# Only for IMESSAGE_MODE=cloud. From your Photon project.
# PHOTON_PROJECT_ID=
# PHOTON_PROJECT_SECRET=

# Only for IMESSAGE_MODE=linq. From `linq signup` or the Linq dashboard.
# LINQ_API_KEY=

# Optional. Where the Python service listens. Defaults to http://127.0.0.1:8787.
# SCOUT_URL=http://127.0.0.1:8787
